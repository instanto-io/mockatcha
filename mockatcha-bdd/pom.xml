<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.instanto</groupId>
    <artifactId>mockatcha</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>mockatcha-bdd</artifactId>
  <name>Mockatcha BDD</name>
  <description>Spies, call inspection, and matchers for Mockatcha tests, following Jasmine.</description>

  <dependencies>
        <!-- Keep before teavm-junit: includes the rule-aware runner and lifecycle fix. -->
        <dependency>
            <groupId>io.instanto</groupId>
            <artifactId>instanto-teavm-extensions</artifactId>
            <scope>test</scope>
        </dependency>
    <dependency>
      <groupId>io.instanto</groupId>
      <artifactId>mockatcha-core</artifactId>
    </dependency>
    <!-- objectContaining generates a property reader while TeaVM compiles the test. -->
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-metaprogramming-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <!-- PlatformMarker: lets ObjectMatchers drop its JVM branch from TeaVM builds. -->
      <groupId>org.teavm</groupId>
      <artifactId>teavm-interop</artifactId>
      <version>${teavm.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-extension-apis</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-classlib</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-junit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <!-- Portable code lives in src/main; each platform's own code in src/jre and src/teavm. -->
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.1</version>
        <executions>
          <execution>
            <id>add-platform-sources</id>
            <phase>generate-sources</phase>
            <goals><goal>add-source</goal></goals>
            <configuration>
              <sources>
                <source>src/jre/java</source>
                <source>src/teavm/java</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <teavm.junit.target>${project.build.directory}/js-tests</teavm.junit.target>
            <teavm.junit.js.runner>${mockatcha.test.browser}</teavm.junit.js.runner>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
