<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.instanto</groupId>
    <artifactId>mockatcha</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>mockatcha-dom</artifactId>
  <name>Mockatcha DOM</name>
  <description>Containers, queries, events, and assertions for TeaVM tests that render.</description>

  <dependencies>
    <!-- Compiler-side support for DOM casts across window boundaries. -->
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-core</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.instanto</groupId>
      <artifactId>mockatcha-webapp-testkit</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-jso-apis</artifactId>
      <version>${teavm.version}</version>
    </dependency>
    <!-- DomTest is a base class and DomRule is a rule used by consumer tests. -->
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- Declared before teavm-junit so rules run in this module's own tests. -->
    <dependency>
      <groupId>io.instanto</groupId>
      <artifactId>teavm-rule-support</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.instanto</groupId>
      <artifactId>mockatcha-bdd</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-classlib</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-junit</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.6.3</version>
        <executions>
          <execution>
            <id>stage-browser-applications</id>
            <phase>process-test-resources</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <mainClass>io.instanto.mockatcha.browser.ApplicationFiles</mainClass>
              <classpathScope>test</classpathScope>
              <arguments>
                <argument>${project.basedir}/src/test/applications</argument>
                <argument>${project.build.testOutputDirectory}/applications</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>stage-webapp-example</id>
            <phase>process-test-resources</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <mainClass>io.instanto.mockatcha.browser.ApplicationFiles</mainClass>
              <classpathScope>test</classpathScope>
              <arguments>
                <argument>${maven.multiModuleProjectDirectory}/mockatcha-webapp-example/src/main/resources/webapp</argument>
                <argument>${project.build.testOutputDirectory}/applications/plain-js</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <teavm.junit.target>${project.build.directory}/js-tests</teavm.junit.target>
            <teavm.junit.js.runner>${mockatcha.test.browser}</teavm.junit.js.runner>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
