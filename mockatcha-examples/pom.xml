<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.instanto</groupId>
    <artifactId>mockatcha</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>mockatcha-examples</artifactId>
  <name>Mockatcha Examples</name>
  <description>Executable examples of Mockatcha testing principles.</description>

  <properties>
    <!-- This module is an exercise for repository checkouts, not a consumer dependency. -->
    <maven.deploy.skip>true</maven.deploy.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.instanto</groupId>
      <artifactId>mockatcha-core</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Declared before teavm-junit so its copies of the runner classes win on the classpath. -->
    <dependency>
      <groupId>io.instanto</groupId>
      <artifactId>teavm-rule-support</artifactId>
      <version>${teavm-rule-support.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- The sparkline example draws to a canvas, so the browser APIs are compiled in. -->
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-jso-apis</artifactId>
      <version>${teavm.version}</version>
    </dependency>
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-classlib</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-junit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <teavm.junit.target>${project.build.directory}/js-tests</teavm.junit.target>
            <teavm.junit.js.runner>${mockatcha.test.browser}</teavm.junit.js.runner>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
